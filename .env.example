# Copy this file to .env and fill in real values:   Copy-Item .env.example .env
# NEVER commit .env (it is in .gitignore). This example file must only ever contain placeholders.

# --- NVD (Milestone 3): free key at https://nvd.nist.gov/developers/request-an-api-key ---
NVD_API_KEY=your-nvd-api-key

# --- LLM and embeddings (Milestones 7-9): key from https://console.groq.com ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-m3

# --- Neo4j Aura (Milestone 10): details from https://console.neo4j.io ---
NEO4J_URI=neo4j+ssc://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-instance-id>
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=<your-instance-id>
AURA_INSTANCEID=<your-instance-id>
AURA_INSTANCENAME=<your-instance-name>
NEO4J_USER=neo4j

# --- MongoDB Atlas (Milestone 12) ---
MONGODB_URI=mongodb+srv://<your-user>:<your-password>@<your-cluster>.mongodb.net
MONGODB_DB=cyberintel
MONGODB_USERNAME=<your-user>
MONGODB_PASSWORD=your-mongodb-password

# --- Collector settings (Milestone 3) ---
HTTP_TIMEOUT_SECONDS=30
USER_AGENT=CyberIntelGraph/0.1 (research project)

# --- Application secrets (Milestones 15-16). Generate each one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-random-jwt-secret
WEBHOOK_SECRET=your-random-webhook-secret
