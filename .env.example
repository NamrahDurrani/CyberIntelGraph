# Copy this file to .env and fill in real values:
#   Copy-Item .env.example .env
# NEVER commit .env (it is already in .gitignore).

# --- NVD (Milestone 3) - free key: https://nvd.nist.gov/developers/request-an-api-key ---
NVD_API_KEY=

# --- LLM / embeddings (Milestones 7-9) ---
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=BAAI/bge-m3

# --- Neo4j (Milestone 10) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- MongoDB (Milestone 12) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cyberintelgraph

# --- Collector settings (Milestone 3) ---
HTTP_TIMEOUT_SECONDS=30
USER_AGENT=CyberIntelGraph/0.1 (research project)
